import "../assets/fonts/Unbounded.ttf";

component AppButton {
    in property <string> text;
    in property <color> bg: #1e2230;
    in property <color> hover_bg: #2e3346;
    in property <color> text_color: #e2e4ed;
    in property <color> border_color: #2e3346;
    in property <length> font_size: 11px;
    in property <length> border_radius: 12px;
    callback clicked();

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.border_radius;
        background: ta.pressed ? root.bg : (ta.has-hover ? root.hover_bg : root.bg);
        border-width: 1px;
        border-color: root.border_color;
        animate background { duration: 100ms; }

        Text {
            width: 100%;
            height: 100%;
            text: root.text;
            font-size: root.font_size;
            font-weight: 700;
            color: root.text_color;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        ta := TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
}

component SelectPill {
    in property <string> text;
    in property <bool> is_selected: false;
    in property <color> active_color: #7bd0c1;
    in property <color> active_bg: #1b3d35;
    in property <length> font_size: 10px;
    callback clicked();

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 8px;
        background: root.is_selected ? root.active_bg : (ta.has-hover ? #252837 : #1c1f2b);
        border-width: 1px;
        border-color: root.is_selected ? root.active_color : (ta.has-hover ? #363a4d : #252837);
        animate background { duration: 100ms; }

        Text {
            width: 100%;
            height: 100%;
            text: root.text;
            font-size: root.font_size;
            font-weight: 700;
            color: root.is_selected ? root.active_color : (ta.has-hover ? #ffffff : #c4c6d2);
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        ta := TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
}

export component MainWindow inherits Window {
    title: "RustCooling";
    no-frame: true;
    width: 360px;
    height: 380px;
    background: transparent;
    default-font-family: "Unbounded";

    // Properties bound to Rust telemetry
    in property <int> cpu_temp: 0;
    in property <int> cpu_load: 0;
    in property <int> cpu_freq: 0;
    in property <bool> is_connected: false;
    in property <string> broadcast_label: "CPU Temperature";
    in property <string> broadcast_value: "—";

    // Translation properties
    in property <string> tr_app_title: "RustCooling";
    in property <string> tr_app_badge: "FX";
    in property <string> tr_device_name: "ID-COOLING FX Series";
    in property <string> tr_device_desc_connected: "USB HID (VID 1A86, PID E317)";
    in property <string> tr_device_desc_searching: "Searching for USB device...";
    in property <string> tr_status_connected: "Connected";
    in property <string> tr_status_searching: "Searching";
    in property <string> tr_display_card_title: "PUMP DISPLAY OUTPUT";
    in property <string> tr_chip_temp: "Temperature";
    in property <string> tr_chip_freq: "Frequency";
    in property <string> tr_chip_load: "Load";
    in property <string> tr_btn_settings: "Settings";
    in property <string> tr_settings_title: "SETTINGS";
    in property <string> tr_btn_back: "← Back";
    in property <string> tr_setting_display_mode: "Display Mode on Pump Screen";
    in property <string> tr_mode_temp: "Temperature";
    in property <string> tr_mode_freq: "Frequency";
    in property <string> tr_mode_load: "Load";
    in property <string> tr_mode_carousel: "Carousel";
    in property <string> tr_setting_freq_format: "Frequency Format";
    in property <string> tr_freq_ghz: "GHz (4.6 GHz)";
    in property <string> tr_freq_mhz: "MHz (4600 MHz)";
    in property <string> tr_setting_language: "Interface Language";
    in property <string> tr_btn_save_return: "Save & Return";

    // Settings View State
    in-out property <bool> show_settings: false;
    in-out property <string> setting_display_mode: "temp"; // "temp", "freq", "load", "carousel"
    in-out property <bool> setting_freq_ghz: true;
    in-out property <int> setting_interval_ms: 1000;
    in-out property <string> setting_language: "en";

    // Callbacks to Rust
    callback save_settings(string, bool, int, string);
    callback minimize_window();
    callback close_window();
    callback drag_window();

    pure function temp_accent(temp: int) -> color {
        if temp < 50 {
            return #7bd0c1; // Mint Teal
        } else if temp < 68 {
            return #fde293; // Soft Amber
        } else if temp < 80 {
            return #ffb77c; // Coral Peach
        } else {
            return #ffb4ab; // Crimson Alert
        }
    }

    // Outer container with rounded corners and subtle border
    Rectangle {
        width: 100%;
        height: 100%;
        background: #101218;
        border-radius: 16px;
        border-width: 1px;
        border-color: #272a38;
        clip: true;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // ==================== CUSTOM TITLE BAR ====================
            Rectangle {
                height: 46px;
                background: #141620;

                // Drag Area for frameless window
                TouchArea {
                    width: parent.width - 48px;
                    height: parent.height;
                    x: 0px;
                    y: 0px;

                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down {
                            root.drag_window();
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    alignment: space-between;

                    // Brand Title + Badge
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        Text {
                            text: root.tr_app_title;
                            font-size: 14px;
                            font-weight: 800;
                            color: #e2e4ed;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 28px;
                            height: 18px;
                            border-radius: 9px;
                            background: #252837;

                            Text {
                                width: 100%;
                                height: 100%;
                                text: root.tr_app_badge;
                                font-size: 9px;
                                font-weight: 800;
                                color: #7bd0c1;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Window Close Button ✕ (Minimizes to tray)
                    close_btn := Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 8px;
                        background: close_touch.has-hover ? #ba1a1a : transparent;
                        animate background { duration: 100ms; }

                        Path {
                            width: 12px;
                            height: 12px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            stroke: close_touch.has-hover ? #ffffff : #c4c6d2;
                            stroke-width: 1.8px;
                            commands: "M 1 1 L 11 11 M 11 1 L 1 11";
                        }

                        close_touch := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.close_window();
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: #222432;
            }

            // ==================== CONTENT: MONITOR VIEW ====================
            if !root.show_settings : VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 10px;

                // 1. Device Hardware Status Bar
                Rectangle {
                    height: 44px;
                    background: #171924;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #272a38;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: space-between;

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;

                            Text {
                                text: root.tr_device_name;
                                font-size: 11px;
                                font-weight: 700;
                                color: #d4d6e2;
                            }

                            Text {
                                text: root.is_connected ? root.tr_device_desc_connected : root.tr_device_desc_searching;
                                font-size: 8px;
                                font-weight: 500;
                                color: #8e919f;
                            }
                        }

                        // Status Badge
                        Rectangle {
                            height: 22px;
                            border-radius: 11px;
                            background: root.is_connected ? #12382c : #381a1f;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 5px;
                                alignment: center;

                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: root.is_connected ? #7bd0c1 : #ffb4ab;
                                }

                                Text {
                                    text: root.is_connected ? root.tr_status_connected : root.tr_status_searching;
                                    font-size: 9px;
                                    font-weight: 700;
                                    color: root.is_connected ? #7bd0c1 : #ffb4ab;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // 2. Main Pump Display Card
                Rectangle {
                    background: #151722;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: #272a38;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;

                        // Card Header Row
                        HorizontalLayout {
                            alignment: space-between;
                            height: 20px;

                            Text {
                                text: root.tr_display_card_title;
                                font-size: 10px;
                                font-weight: 800;
                                color: #8c90a2;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                height: 20px;
                                border-radius: 10px;
                                background: #232738;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: center;

                                    Text {
                                        text: root.setting_display_mode == "freq" ? root.tr_mode_freq :
                                              root.setting_display_mode == "load" ? root.tr_mode_load :
                                              root.setting_display_mode == "carousel" ? root.tr_mode_carousel : root.tr_mode_temp;
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: #a8c7fa;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Big Display Value & Subtitle
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;

                            Text {
                                text: root.broadcast_value;
                                font-size: 46px;
                                font-weight: 800;
                                color: root.temp_accent(root.cpu_temp);
                                horizontal-alignment: center;
                            }

                            Text {
                                text: root.broadcast_label;
                                font-size: 11px;
                                font-weight: 600;
                                color: #9b9fae;
                                horizontal-alignment: center;
                            }
                        }

                        // Metrics Summary Columns (No 4-letter abbreviations!)
                        HorizontalLayout {
                            spacing: 8px;
                            height: 48px;

                            // Temp Box
                            Rectangle {
                                horizontal-stretch: 1;
                                background: #1c1f2d;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #252837;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;

                                    Text {
                                        text: root.tr_chip_temp;
                                        font-size: 8px;
                                        font-weight: 600;
                                        color: #8c909e;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: root.cpu_temp > 0 ? "\{root.cpu_temp}°C" : "—";
                                        font-size: 12px;
                                        font-weight: 800;
                                        color: root.temp_accent(root.cpu_temp);
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            // Freq Box
                            Rectangle {
                                horizontal-stretch: 1;
                                background: #1c1f2d;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #252837;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;

                                    Text {
                                        text: root.tr_chip_freq;
                                        font-size: 8px;
                                        font-weight: 600;
                                        color: #8c909e;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: root.cpu_freq > 0 ? (root.setting_freq_ghz ? "\{Math.round(root.cpu_freq / 100) / 10} GHz" : "\{root.cpu_freq} MHz") : "—";
                                        font-size: 12px;
                                        font-weight: 800;
                                        color: #d0bcff;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            // Load Box
                            Rectangle {
                                horizontal-stretch: 1;
                                background: #1c1f2d;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #252837;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;

                                    Text {
                                        text: root.tr_chip_load;
                                        font-size: 8px;
                                        font-weight: 600;
                                        color: #8c909e;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: root.cpu_load >= 0 ? "\{root.cpu_load}%" : "—";
                                        font-size: 12px;
                                        font-weight: 800;
                                        color: #a8c7fa;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // 3. Bottom Row: ONLY ONE BUTTON: [ Settings ]
                AppButton {
                    height: 40px;
                    text: root.tr_btn_settings;
                    bg: #1e2230;
                    hover_bg: #2e3346;
                    text_color: #e2e4ed;
                    border_color: #2e3346;
                    font_size: 11px;
                    border_radius: 12px;
                    clicked => {
                        root.show_settings = true;
                    }
                }
            }

            // ==================== CONTENT: SETTINGS VIEW ====================
            if root.show_settings : VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 8px;

                // Settings Header Row
                HorizontalLayout {
                    alignment: space-between;
                    height: 28px;

                    Text {
                        text: root.tr_settings_title;
                        font-size: 12px;
                        font-weight: 800;
                        color: #e2e4ed;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 76px;
                        height: 26px;

                        SelectPill {
                            text: root.tr_btn_back;
                            font_size: 9px;
                            is_selected: false;
                            clicked => {
                                root.save_settings(
                                    root.setting_display_mode,
                                    root.setting_freq_ghz,
                                    root.setting_interval_ms,
                                    root.setting_language
                                );
                                root.show_settings = false;
                            }
                        }
                    }
                }

                // Option 1: Display Mode
                Rectangle {
                    background: #171924;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #272a38;
                    height: 54px;

                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 4px;

                        Text {
                            text: root.tr_setting_display_mode;
                            font-size: 10px;
                            font-weight: 700;
                            color: #d4d6e2;
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            height: 26px;

                            SelectPill {
                                text: root.tr_mode_temp;
                                is_selected: root.setting_display_mode == "temp";
                                active_color: #7bd0c1;
                                active_bg: #1b3d35;
                                clicked => { root.setting_display_mode = "temp"; }
                            }
                            SelectPill {
                                text: root.tr_mode_freq;
                                is_selected: root.setting_display_mode == "freq";
                                active_color: #d0bcff;
                                active_bg: #302648;
                                clicked => { root.setting_display_mode = "freq"; }
                            }
                            SelectPill {
                                text: root.tr_mode_load;
                                is_selected: root.setting_display_mode == "load";
                                active_color: #a8c7fa;
                                active_bg: #192d47;
                                clicked => { root.setting_display_mode = "load"; }
                            }
                            SelectPill {
                                text: root.tr_mode_carousel;
                                is_selected: root.setting_display_mode == "carousel";
                                active_color: #fde293;
                                active_bg: #382c18;
                                clicked => { root.setting_display_mode = "carousel"; }
                            }
                        }
                    }
                }

                // Option 2: Frequency Format
                Rectangle {
                    background: #171924;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #272a38;
                    height: 54px;

                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 4px;

                        Text {
                            text: root.tr_setting_freq_format;
                            font-size: 10px;
                            font-weight: 700;
                            color: #d4d6e2;
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            height: 26px;

                            SelectPill {
                                text: root.tr_freq_ghz;
                                is_selected: root.setting_freq_ghz;
                                active_color: #d0bcff;
                                active_bg: #302648;
                                clicked => { root.setting_freq_ghz = true; }
                            }
                            SelectPill {
                                text: root.tr_freq_mhz;
                                is_selected: !root.setting_freq_ghz;
                                active_color: #d0bcff;
                                active_bg: #302648;
                                clicked => { root.setting_freq_ghz = false; }
                            }
                        }
                    }
                }

                // Option 3: Language Selection
                Rectangle {
                    background: #171924;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #272a38;
                    height: 54px;

                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 4px;

                        Text {
                            text: root.tr_setting_language;
                            font-size: 10px;
                            font-weight: 700;
                            color: #d4d6e2;
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            height: 26px;

                            SelectPill {
                                text: "English";
                                is_selected: root.setting_language == "en";
                                active_color: #7bd0c1;
                                active_bg: #1b3d35;
                                clicked => {
                                    root.setting_language = "en";
                                    root.save_settings(
                                        root.setting_display_mode,
                                        root.setting_freq_ghz,
                                        root.setting_interval_ms,
                                        "en"
                                    );
                                }
                            }
                            SelectPill {
                                text: "Русский";
                                is_selected: root.setting_language == "ru";
                                active_color: #7bd0c1;
                                active_bg: #1b3d35;
                                clicked => {
                                    root.setting_language = "ru";
                                    root.save_settings(
                                        root.setting_display_mode,
                                        root.setting_freq_ghz,
                                        root.setting_interval_ms,
                                        "ru"
                                    );
                                }
                            }
                            SelectPill {
                                text: "中文";
                                is_selected: root.setting_language == "zh";
                                active_color: #7bd0c1;
                                active_bg: #1b3d35;
                                clicked => {
                                    root.setting_language = "zh";
                                    root.save_settings(
                                        root.setting_display_mode,
                                        root.setting_freq_ghz,
                                        root.setting_interval_ms,
                                        "zh"
                                    );
                                }
                            }
                        }
                    }
                }

                // Save & Return Button
                AppButton {
                    height: 38px;
                    text: root.tr_btn_save_return;
                    bg: #7bd0c1;
                    hover_bg: #90dcd0;
                    text_color: #101218;
                    border_color: #7bd0c1;
                    font_size: 11px;
                    border_radius: 12px;
                    clicked => {
                        root.save_settings(
                            root.setting_display_mode,
                            root.setting_freq_ghz,
                            root.setting_interval_ms,
                            root.setting_language
                        );
                        root.show_settings = false;
                    }
                }
            }
        }
    }
}
